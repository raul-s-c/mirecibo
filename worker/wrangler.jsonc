{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mirecibo-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "OPENAI_MODEL": "gpt-5.4-mini-2026-03-17"
  },
  "ratelimits": [
    { "name": "ANALYSIS_RATE_LIMITER", "namespace_id": "983741001", "simple": { "limit": 8, "period": 60 } },
    { "name": "COMPARE_RATE_LIMITER", "namespace_id": "983741002", "simple": { "limit": 12, "period": 60 } },
    { "name": "GLOBAL_RATE_LIMITER", "namespace_id": "983741003", "simple": { "limit": 40, "period": 60 } }
  ],
  "secrets": {
    "required": ["OPENAI_API_KEY", "APP_ACCESS_TOKEN"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
